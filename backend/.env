# Lantern Roster backend — tracked, non-secret config. Real secrets go in .env.local.
DATABASE_URL="file:./dev.db"
PORT=4100
CORS_ORIGIN="http://localhost:5273"
JWT_SECRET="dev-only-change-me-please-use-a-long-random-string"
# Local "pick a demo user" sign-in. Always off when NODE_ENV=production.
DEV_AUTH=true
SSO_ALLOWED_DOMAINS="lanterncommunity.org"
